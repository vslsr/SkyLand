{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyland.local/schema/item-catalog.schema.json",
  "title": "SkyLand Item Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.]+$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "category",
        "stackLimit",
        "slotCost",
        "iconId",
        "tint",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "category": {
          "description": "分类决定物品走哪条携带规则，见设计稿 §6.7.1 与 §9.5。",
          "enum": [
            "material",
            "valuable",
            "throwable",
            "supply",
            "ammunition",
            "tool"
          ]
        },
        "stackLimit": {
          "description": "单个货位能堆多少；价值货物固定为 1。",
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "slotCost": {
          "description": "占几个货位。0 表示不挤压背包格数，走各自上限的独立池（弹药、基础工具）。",
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "iconId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "tint": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "durability": {
          "description": "耐久度。0 或不写表示这件东西没有耐久，用不坏也修不了。",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "coinValue": {
          "description": "运到贸易点的出售价；只有价值货物有。",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "contraband": {
          "description": "违禁品：携带时产生可见光柱与额外恶名，不能无风险塞进普通背包。",
          "type": "boolean"
        },
        "holdable": {
          "description": "能不能拿在手上。手持物是挂在角色挂点下的一个纯表现 Actor：没有碰撞、没有掉落物理，坐标由 Actor 嵌套关系解算。",
          "type": "boolean"
        },
        "ammo": {
          "description": "弹药位：这件东西吃哪几种弹药、装几发。只有 slotCost 为 0 且 stackLimit 为 1 的物品能写；装了多少记在账本那一格上，不记在目录里。",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accepts",
            "capacity"
          ],
          "properties": {
            "accepts": {
              "description": "能装进来的物品 id。写的是 id 不是分类：弹弓吃的是普通石头，而石头是材料。",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            },
            "capacity": {
              "description": "最多装几发。",
              "type": "integer",
              "minimum": 1,
              "maximum": 999
            }
          }
        },
        "use": {
          "description": "使用这件东西时做什么。使用的兑现路径是「授予玩家一条 Ability → 按 mode 激活 → 完成后收回」；不写表示这件东西没有用法。",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "input",
            "mode",
            "value"
          ],
          "properties": {
            "action": {
              "description": "用起来做什么。动词由 server/actors/ItemUseActions.mjs 上注册的执行器兑现；shoot 的执行器归武器系统。",
              "enum": [
                "eat",
                "shoot",
                "tool",
                "throw"
              ]
            },
            "input": {
              "description": "走哪个逻辑输入槽。物理键位由 config/input/player.input.json 决定，这里不写死键；目前只有主手，加副手是往这个枚举里加一个值。",
              "enum": [
                "primary"
              ]
            },
            "mode": {
              "description": "tap 点一下就激活；hold 按住到倒计时走完那一刻激活，中途松手是取消；charge 按住蓄力、松手那一刻激活，蓄到几成由比例说了算。",
              "enum": [
                "tap",
                "hold",
                "charge"
              ]
            },
            "holdSeconds": {
              "description": "那个圈多长，单位秒。mode 为 hold / charge 时必填，tap 不能写。",
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10
            },
            "cooldownSeconds": {
              "description": "用完之后多久才能再用一次，单位秒。不写或 0 表示没有冷却；落成能力自己的 cooldown，由 GAS 判定。",
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 60
            },
            "value": {
              "description": "eat 是一次吃掉几个；tool 是额外采集伤害；throw 是投掷初速度的十倍（80 即 8 m/s）；shoot 的含义由武器系统的执行器解释。",
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        },
        "weapon": {
          "description": "武器数据（设计稿 @w 的 D）。只有 use.action 为 shoot 的物品才写它；写了才打得响，冷却写在 use.cooldownSeconds 上。",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attack",
            "radius",
            "range",
            "charge"
          ],
          "properties": {
            "attack": {
              "description": "满蓄力之前的基础攻击力（D.Attack）。",
              "type": "number",
              "minimum": 0,
              "maximum": 100000
            },
            "radius": {
              "description": "落点周围这个半径内的目标全部命中（D.EQS）。",
              "type": "number",
              "minimum": 0.2,
              "maximum": 16
            },
            "range": {
              "description": "空放阈值处与拉满时分别打多远，米。落点由朝向与蓄力比例反解，抛物线只是表现。",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minimum",
                "maximum"
              ],
              "properties": {
                "minimum": {
                  "description": "刚过空放阈值时的射程。",
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 64
                },
                "maximum": {
                  "description": "拉满时的射程。",
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 64
                }
              }
            },
            "charge": {
              "description": "蓄力怎么换算成这一下的强度。",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minimumRatio",
                "damageScale"
              ],
              "properties": {
                "minimumRatio": {
                  "description": "低于它视为空放：不发射，也不进冷却。",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.9
                },
                "damageScale": {
                  "description": "伤害倍率随蓄力比例在这两个数之间线性变化。",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "minimum",
                    "maximum"
                  ],
                  "properties": {
                    "minimum": {
                      "description": "空放阈值处的倍率。",
                      "type": "number",
                      "minimum": 0,
                      "maximum": 10
                    },
                    "maximum": {
                      "description": "拉满时的倍率。",
                      "type": "number",
                      "minimum": 0,
                      "maximum": 10
                    }
                  }
                }
              }
            },
            "tagMultipliers": {
              "description": "按目标标签改判倍率（D.Attack.Tag）。按声明顺序取第一条命中的；Actor.Build 匹配得上 Actor.Build.Wall。",
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tag",
                  "multiplier"
                ],
                "properties": {
                  "tag": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)*$"
                  },
                  "multiplier": {
                    "description": "倍率。",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
