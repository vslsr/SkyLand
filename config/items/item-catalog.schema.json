{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyland.local/schema/item-catalog.schema.json",
  "title": "SkyLand Item Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.]+$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "category",
        "stackLimit",
        "slotCost",
        "iconId",
        "tint",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "category": {
          "description": "分类决定物品走哪条携带规则，见设计稿 §6.7.1 与 §9.5。",
          "enum": [
            "material",
            "valuable",
            "throwable",
            "supply",
            "ammunition",
            "tool"
          ]
        },
        "stackLimit": {
          "description": "单个货位能堆多少；价值货物固定为 1。",
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "slotCost": {
          "description": "占几个货位。0 表示不挤压背包格数，走各自上限的独立池（弹药、基础工具）。",
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "iconId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "tint": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "coinValue": {
          "description": "运到贸易点的出售价；只有价值货物有。",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "contraband": {
          "description": "违禁品：携带时产生可见光柱与额外恶名，不能无风险塞进普通背包。",
          "type": "boolean"
        },
        "holdable": {
          "description": "能不能拿在手上。手持物是挂在角色手部挂点上的一个真 Actor。",
          "type": "boolean"
        },
        "use": {
          "description": "手持这件东西时怎么用它。不写表示只能拿着，按键没有反应。",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "input",
            "mode",
            "value"
          ],
          "properties": {
            "action": {
              "description": "用起来做什么。只登记已经有系统兑现的效果。",
              "enum": [
                "tool",
                "throw"
              ]
            },
            "input": {
              "description": "走哪个逻辑输入槽。物理键位由 config/input/player.input.json 决定，这里不写死键。",
              "enum": [
                "primary",
                "secondary"
              ]
            },
            "mode": {
              "description": "tap 是按下即结算；charge 是按住蓄力、松手结算，蓄力比例作为强度。",
              "enum": [
                "tap",
                "charge"
              ]
            },
            "chargeSeconds": {
              "description": "蓄满要多久，单位秒。mode 为 charge 时必填，tap 不能写。",
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10
            },
            "value": {
              "description": "tool 是额外采集伤害；throw 是蓄满时的投掷初速度的十倍（80 即 8 m/s）。",
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        }
      }
    }
  }
}
