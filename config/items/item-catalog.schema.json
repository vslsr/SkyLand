{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyland.local/schema/item-catalog.schema.json",
  "title": "SkyLand Item Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9.]+$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "category", "stackLimit", "slotCost", "iconId", "tint", "summary"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 32 },
        "category": {
          "description": "分类决定物品走哪条携带规则，见设计稿 §6.7.1 与 §9.5。",
          "enum": ["material", "valuable", "throwable", "supply", "ammunition", "tool"]
        },
        "stackLimit": {
          "description": "单个货位能堆多少；价值货物固定为 1。",
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "slotCost": {
          "description": "占几个货位。0 表示不挤压背包格数，走各自上限的独立池（弹药、基础工具）。",
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "iconId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "tint": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 64 },
        "coinValue": {
          "description": "运到贸易点的出售价；只有价值货物有。",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "contraband": {
          "description": "违禁品：携带时产生可见光柱与额外恶名，不能无风险塞进普通背包。",
          "type": "boolean"
        }
      }
    }
  }
}
