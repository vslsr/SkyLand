{
  "$schema": "./actor.schema.json",
  "schemaVersion": 1,
  "id": "mushroom-pile",
  "components": {
    "interactable": {
      "action": "pickup-stack",
      "label": "蘑菇",
      "maximumDistance": 2.4
    },
    "itemStack": {
      "itemType": "mushroom",
      "displayName": "蘑菇",
      "defaultQuantity": 1,
      "maximumQuantity": 999,
      "compatibilityKey": "mushroom-standard"
    },
    "actorResidency": {
      "sleepDelaySeconds": 1,
      "dormantDelaySeconds": 3,
      "dormantEligible": true
    },
    "dropMotion": {
      "gravity": 9.8,
      "drag": 0.5,
      "groundDrag": 2.6,
      "restitution": 0.2,
      "radius": 0.16,
      "settleSpeed": 0.08
    },
    "lifetime": {
      "lifetimeSeconds": 900
    },
    "replicationPolicy": {
      "mode": "aoi",
      "radiusChunks": 2
    },
    "render": {
      "model": "line-art-mushroom-pile",
      "capColor": "#C97868",
      "stemColor": "#EADFC5",
      "inkColor": "#51463E",
      "radius": 0.2,
      "height": 0.34
    }
  }
}
