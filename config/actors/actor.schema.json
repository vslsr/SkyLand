{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyland.local/schema/actor.schema.json",
  "title": "SkyLand Actor Archetype",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["render"] },
        { "required": ["generatedTree"] }
      ],
      "properties": {
        "playerMovement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["walkSpeed", "sprintMultiplier", "maximumStepHeight"],
          "properties": {
            "walkSpeed": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
            "sprintMultiplier": { "type": "number", "minimum": 1, "maximum": 4 },
            "maximumStepHeight": { "type": "number", "minimum": 0, "maximum": 2 }
          }
        },
        "buoyancy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimumBeam", "minimumLength", "maximumTrimRadians", "minimumDraft", "maximumDraft", "parts"],
          "properties": {
            "minimumBeam": { "type": "number", "exclusiveMinimum": 0 },
            "minimumLength": { "type": "number", "exclusiveMinimum": 0 },
            "maximumTrimRadians": { "type": "number", "minimum": 0, "maximum": 0.25 },
            "minimumDraft": { "type": "number", "minimum": 0 },
            "maximumDraft": { "type": "number", "minimum": 0 },
            "parts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "mass", "buoyancy", "integrity", "localX", "localZ"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                  "mass": { "type": "number", "minimum": 0 },
                  "buoyancy": { "type": "number", "minimum": 0 },
                  "integrity": { "type": "number", "minimum": 0, "maximum": 1 },
                  "localX": { "type": "number" },
                  "localZ": { "type": "number" }
                }
              }
            }
          }
        },
        "vesselMotor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximumForwardSpeed", "maximumReverseSpeed", "acceleration", "deceleration", "drag", "turnSpeed", "inputTimeoutMs"],
          "properties": {
            "maximumForwardSpeed": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
            "maximumReverseSpeed": { "type": "number", "exclusiveMinimum": 0, "maximum": 15 },
            "acceleration": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
            "deceleration": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
            "drag": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
            "turnSpeed": { "type": "number", "exclusiveMinimum": 0, "maximum": 6.2832 },
            "inputTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 2000 }
          }
        },
        "interactable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "label", "maximumDistance"],
          "properties": {
            "action": { "enum": ["cargo-toggle", "mushroom-bite", "pickup-stack", "chop-tree"] },
            "label": { "type": "string", "minLength": 1, "maxLength": 32 },
            "maximumDistance": { "type": "number", "minimum": 0.5, "maximum": 12 }
          }
        },
        "cargo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mass", "mountLocalX", "mountLocalY", "mountLocalZ"],
          "properties": {
            "mass": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
            "mountLocalX": { "type": "number", "minimum": -10, "maximum": 10 },
            "mountLocalY": { "type": "number", "minimum": -2, "maximum": 10 },
            "mountLocalZ": { "type": "number", "minimum": -10, "maximum": 10 }
          }
        },
        "elasticTether": {
          "type": "object",
          "additionalProperties": false,
          "required": ["restLength", "breakLength", "mouthHeight", "mouthForwardOffset"],
          "properties": {
            "restLength": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
            "breakLength": { "type": "number", "exclusiveMinimum": 0, "maximum": 12 },
            "mouthHeight": { "type": "number", "minimum": 0, "maximum": 3 },
            "mouthForwardOffset": { "type": "number", "minimum": 0, "maximum": 2 }
          }
        },
        "hazard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["radius", "damage", "cooldownMs", "partId"],
          "properties": {
            "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
            "damage": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "cooldownMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
            "partId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          }
        },
        "temperature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initialTemperature", "ambientTemperature", "heatCapacity", "coolingRate"],
          "properties": {
            "initialTemperature": { "type": "number", "minimum": -100, "maximum": 2000 },
            "ambientTemperature": { "type": "number", "minimum": -100, "maximum": 2000 },
            "heatCapacity": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 },
            "coolingRate": { "type": "number", "minimum": 0, "maximum": 10 }
          }
        },
        "combustible": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ignitionTemperature",
            "extinguishTemperature",
            "fuel",
            "burnRate",
            "heatOutput",
            "heatRadius"
          ],
          "properties": {
            "ignitionTemperature": { "type": "number", "minimum": -100, "maximum": 2000 },
            "extinguishTemperature": { "type": "number", "minimum": -100, "maximum": 2000 },
            "fuel": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
            "burnRate": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 },
            "heatOutput": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
            "heatRadius": { "type": "number", "exclusiveMinimum": 0, "maximum": 32 }
          }
        },
        "heatEmitter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["power", "radius", "enabled"],
          "properties": {
            "power": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
            "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 32 },
            "enabled": { "type": "boolean" }
          }
        },
        "itemStack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["itemType", "displayName", "defaultQuantity", "maximumQuantity", "compatibilityKey"],
          "properties": {
            "itemType": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "displayName": { "type": "string", "minLength": 1, "maxLength": 32 },
            "defaultQuantity": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "maximumQuantity": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "compatibilityKey": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          }
        },
        "actorResidency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sleepDelaySeconds", "dormantDelaySeconds", "dormantEligible"],
          "properties": {
            "sleepDelaySeconds": { "type": "number", "minimum": 0, "maximum": 60 },
            "dormantDelaySeconds": { "type": "number", "minimum": 0, "maximum": 600 },
            "dormantEligible": { "type": "boolean" }
          }
        },
        "dropMotion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gravity", "drag", "settleSpeed"],
          "properties": {
            "gravity": { "type": "number", "minimum": 0, "maximum": 50 },
            "drag": { "type": "number", "minimum": 0, "maximum": 50 },
            "settleSpeed": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 }
          }
        },
        "lifetime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lifetimeSeconds"],
          "properties": {
            "lifetimeSeconds": { "type": "number", "minimum": 0, "maximum": 86400 }
          }
        },
        "replicationPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "radiusChunks"],
          "properties": {
            "mode": { "enum": ["always", "aoi"] },
            "radiusChunks": { "type": "integer", "minimum": 0, "maximum": 8 }
          }
        },
        "generatedTree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximumHealth", "chopDamage", "woodQuantity"],
          "properties": {
            "maximumHealth": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "chopDamage": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "woodQuantity": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        },
        "render": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "model",
                "radius",
                "membraneColor",
                "middleColor",
                "coreColor",
                "bubbleColor",
                "inkColor",
                "shadowColor"
              ],
              "properties": {
                "model": { "const": "line-art-player-slime" },
                "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 },
                "membraneColor": { "$ref": "#/$defs/color" },
                "middleColor": { "$ref": "#/$defs/color" },
                "coreColor": { "$ref": "#/$defs/color" },
                "bubbleColor": { "$ref": "#/$defs/color" },
                "inkColor": { "$ref": "#/$defs/color" },
                "shadowColor": { "$ref": "#/$defs/color" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["model", "foamColor", "length", "width"],
              "properties": {
                "model": { "const": "line-art-raft" },
                "foamColor": { "$ref": "#/$defs/color" },
                "length": { "type": "number", "exclusiveMinimum": 0 },
                "width": { "type": "number", "exclusiveMinimum": 0 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["model", "color", "accentColor", "length", "width", "height"],
              "properties": {
                "model": { "const": "line-art-cargo-crate" },
                "color": { "$ref": "#/$defs/color" },
                "accentColor": { "$ref": "#/$defs/color" },
                "length": { "type": "number", "exclusiveMinimum": 0 },
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["model", "color", "accentColor", "radius", "height"],
              "properties": {
                "model": { "const": "line-art-reef" },
                "color": { "$ref": "#/$defs/color" },
                "accentColor": { "$ref": "#/$defs/color" },
                "radius": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["model", "capColor", "stemColor", "spotColor", "radius", "height"],
              "properties": {
                "model": { "const": "line-art-elastic-mushroom" },
                "capColor": { "$ref": "#/$defs/color" },
                "stemColor": { "$ref": "#/$defs/color" },
                "spotColor": { "$ref": "#/$defs/color" },
                "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
                "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["model", "woodColor", "accentColor", "radius", "height"],
              "properties": {
                "model": { "const": "line-art-training-dummy" },
                "woodColor": { "$ref": "#/$defs/color" },
                "accentColor": { "$ref": "#/$defs/color" },
                "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
                "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 6 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["model", "stoneColor", "crystalColor", "radius", "height"],
              "properties": {
                "model": { "const": "line-art-focus-obelisk" },
                "stoneColor": { "$ref": "#/$defs/color" },
                "crystalColor": { "$ref": "#/$defs/color" },
                "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
                "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 6 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["model", "color", "accentColor", "width", "length", "height"],
              "properties": {
                "model": { "const": "line-art-floor-plaque" },
                "color": { "$ref": "#/$defs/color" },
                "accentColor": { "$ref": "#/$defs/color" },
                "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 12 },
                "length": { "type": "number", "exclusiveMinimum": 0, "maximum": 12 },
                "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["model", "stoneColor", "woodColor", "emberColor", "radius", "height"],
              "properties": {
                "model": { "const": "line-art-campfire" },
                "stoneColor": { "$ref": "#/$defs/color" },
                "woodColor": { "$ref": "#/$defs/color" },
                "emberColor": { "$ref": "#/$defs/color" },
                "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
                "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["model", "color", "accentColor", "radius", "height"],
              "properties": {
                "model": { "const": "line-art-dry-hay" },
                "color": { "$ref": "#/$defs/color" },
                "accentColor": { "$ref": "#/$defs/color" },
                "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
                "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["model", "woodColor", "cutColor", "inkColor", "radius", "height"],
              "properties": {
                "model": { "const": "line-art-wood-pile" },
                "woodColor": { "$ref": "#/$defs/color" },
                "cutColor": { "$ref": "#/$defs/color" },
                "inkColor": { "$ref": "#/$defs/color" },
                "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
                "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
  }
}
