{
  "$schema": "./actor.schema.json",
  "schemaVersion": 1,
  "id": "fruit-pile",
  "components": {
    "interactable": {
      "action": "pickup-stack",
      "label": "果子",
      "maximumDistance": 2.4
    },
    "itemStack": {
      "itemType": "fruit",
      "displayName": "果子",
      "defaultQuantity": 1,
      "maximumQuantity": 999,
      "compatibilityKey": "fruit-standard"
    },
    "actorResidency": {
      "sleepDelaySeconds": 1,
      "dormantDelaySeconds": 3,
      "dormantEligible": true
    },
    "dropMotion": {
      "gravity": 9.8,
      "drag": 0.45,
      "groundDrag": 2.4,
      "restitution": 0.28,
      "radius": 0.14,
      "settleSpeed": 0.08
    },
    "lifetime": {
      "lifetimeSeconds": 300
    },
    "replicationPolicy": {
      "mode": "aoi",
      "radiusChunks": 2
    },
    "temperature": {
      "initialTemperature": 20,
      "ambientTemperature": 20,
      "heatCapacity": 6,
      "coolingRate": 0.2
    },
    "render": {
      "model": "line-art-fruit-pile",
      "fruitColor": "#D4694F",
      "accentColor": "#E8A24C",
      "inkColor": "#5C2F26",
      "radius": 0.42,
      "height": 0.3
    }
  }
}
