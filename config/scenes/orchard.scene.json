{
  "$schema": "./scene.schema.json",
  "schemaVersion": 1,
  "id": "orchard",
  "displayName": "果林",
  "description": "和无边草原同一套世界生成，树换成了可反复采摘的果树。",
  "capacity": 16,
  "sceneComponents": [],
  "environment": {
    "weather": {
      "initial": "cloudy",
      "cycle": {
        "enabled": true,
        "minimumSeconds": 120,
        "maximumSeconds": 300,
        "candidates": ["sunny", "cloudy", "rain"]
      }
    },
    "dayNight": {
      "enabled": true,
      "startHour": 10.5,
      "dayLengthSeconds": 720
    }
  },
  "actors": [],
  "renderer": {
    "type": "line-art",
    "background": "#fdfaf2",
    "fog": { "color": "#fdfaf2", "near": 26, "far": 60 },
    "content": { "ground": true, "trees": true, "grass": true, "ocean": true },
    "palette": {
      "ground": "#e4dabf",
      "grass": "#c7d79f",
      "treeTrunk": "#cbb094",
      "treeNeedles": "#b9d2a4"
    },
    "ocean": {
      "size": 32,
      "segments": 16,
      "waveHeight": 0.32,
      "waveSpeed": 0.82,
      "noiseScale": 0.085,
      "noiseStrength": 1.15,
      "interlaceStrength": 0.42,
      "surfaceColor": "#c9e6f2",
      "secondaryColor": "#b7dbea",
      "deepColor": "#2f6f96",
      "depthColorRange": 2.5,
      "gridLineColor": "#5f8195",
      "gridLineOpacity": 0.25
    },
    "world": {
      "loadRadius": 2,
      "keepRadius": 3,
      "rockColor": "#d4d0c6"
    }
  },
  "gameplay": {
    "playerActor": { "archetype": "player-slime" },
    "worldProps": {
      "tree": [{ "archetype": "fruit-tree", "weight": 1 }],
      "rock": [{ "archetype": "generated-rock", "weight": 1 }]
    },
    "spawn": { "centerX": 0, "centerZ": 0, "radius": 6, "slots": 16 },
    "water": { "seaLevel": -0.4 }
  },
  "camera": {
    "mode": "topdown",
    "position": [5.5, 7.5, 8.5],
    "yaw": 0,
    "pitch": -0.12,
    "moveSpeed": 6.5
  }
}
