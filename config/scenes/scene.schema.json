{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyland.local/schema/scene.schema.json",
  "title": "SkyLand Scene Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "description",
    "capacity",
    "sceneComponents",
    "actors",
    "renderer",
    "gameplay",
    "camera"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 32 },
    "description": { "type": "string", "minLength": 1, "maxLength": 120 },
    "capacity": { "type": "integer", "minimum": 1, "maximum": 64 },
    "sceneComponents": {
      "type": "array",
      "description": "按声明顺序加载的场景级逻辑组件，类似场景专属 GameMode",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": { "type": { "const": "mouse-grass-interaction" } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "targetActorId"],
            "properties": {
              "type": { "const": "ability-lab" },
              "targetActorId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id",
              "preset",
              "particleCount",
              "clusterRadius",
              "seed",
              "fillColor",
              "accentColor",
              "lineColor",
              "interactionRadius",
              "impulseStrength"
            ],
            "oneOf": [
              { "required": ["position"] },
              { "required": ["worldGeneration"] }
            ],
            "properties": {
              "type": { "const": "interactive-particle-effect" },
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "preset": { "const": "line-art-leaves" },
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "type": "number" }
              },
              "particleCount": { "type": "integer", "minimum": 16, "maximum": 512 },
              "clusterRadius": {
                "type": "number",
                "minimum": 1,
                "maximum": 12,
                "description": "每个生成点的圆形落叶团半径，不会改变单片落叶大小"
              },
              "worldGeneration": {
                "type": "object",
                "additionalProperties": false,
                "required": ["spawnChance"],
                "properties": {
                  "spawnChance": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1,
                    "description": "每个流式 chunk 的候选生成点出现概率"
                  }
                }
              },
              "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
              "fillColor": { "$ref": "#/$defs/color" },
              "accentColor": { "$ref": "#/$defs/color" },
              "lineColor": { "$ref": "#/$defs/color" },
              "interactionRadius": { "type": "number", "minimum": 0.1, "maximum": 4 },
              "impulseStrength": { "type": "number", "minimum": 0.1, "maximum": 12 }
            }
          }
        ]
      }
    },
    "environment": {
      "type": "object",
      "description": "房间权威的天气与昼夜配置；服务端按它推进状态，客户端只渲染表现",
      "additionalProperties": false,
      "properties": {
        "weather": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "initial": { "$ref": "#/$defs/weatherType" },
            "allowPlayerControl": {
              "type": "boolean",
              "description": "是否接受客户端的天气切换请求；关闭后只有服务端循环能改天气"
            },
            "cycle": {
              "type": "object",
              "description": "服务端自动轮换天气；省略表示天气只在被请求时改变",
              "additionalProperties": false,
              "required": ["minimumSeconds", "maximumSeconds", "candidates"],
              "properties": {
                "enabled": { "type": "boolean" },
                "minimumSeconds": { "type": "number", "minimum": 5, "maximum": 7200 },
                "maximumSeconds": { "type": "number", "minimum": 5, "maximum": 7200 },
                "candidates": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 7,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/weatherType" }
                }
              }
            }
          }
        },
        "dayNight": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "关闭时场景恒定停在 startHour，天空、光照与星空按该时刻渲染"
            },
            "paused": {
              "type": "boolean",
              "description": "启用昼夜但冻结时间；用于固定黄昏、夜景这类静态氛围"
            },
            "startHour": { "type": "number", "minimum": 0, "exclusiveMaximum": 24 },
            "dayLengthSeconds": { "type": "number", "minimum": 20, "maximum": 86400 },
            "allowPlayerControl": {
              "type": "boolean",
              "description": "是否接受客户端的时刻跳转请求（调试菜单用）"
            }
          }
        }
      }
    },
    "actors": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "archetype", "localTransform"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "archetype": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "parentActorId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "localTransform": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position", "yaw"],
            "properties": {
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "type": "number" }
              },
              "yaw": { "type": "number" }
            }
          }
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "background", "fog", "content", "palette"],
      "properties": {
        "type": { "const": "line-art" },
        "background": { "$ref": "#/$defs/color" },
        "fog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["color", "near", "far"],
          "properties": {
            "color": { "$ref": "#/$defs/color" },
            "near": { "type": "number", "minimum": 0 },
            "far": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ground", "trees", "grass", "ocean"],
          "properties": {
            "ground": { "type": "boolean" },
            "trees": { "type": "boolean" },
            "grass": { "type": "boolean" },
            "ocean": { "type": "boolean" }
          }
        },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ground", "grass", "treeTrunk", "treeNeedles"],
          "properties": {
            "ground": { "$ref": "#/$defs/color" },
            "grass": { "$ref": "#/$defs/color" },
            "treeTrunk": { "$ref": "#/$defs/color" },
            "treeNeedles": { "$ref": "#/$defs/color" }
          }
        },
        "ocean": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "segments",
            "waveHeight",
            "waveSpeed",
            "noiseScale",
            "noiseStrength",
            "interlaceStrength",
            "surfaceColor",
            "secondaryColor",
            "gridLineColor",
            "gridLineOpacity"
          ],
          "properties": {
            "size": { "type": "number", "minimum": 16, "maximum": 1024 },
            "segments": { "type": "integer", "minimum": 8, "maximum": 128 },
            "waveHeight": { "type": "number", "minimum": 0, "maximum": 1 },
            "waveSpeed": { "type": "number", "minimum": 0, "maximum": 4 },
            "noiseScale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "noiseStrength": { "type": "number", "minimum": 0, "maximum": 3 },
            "interlaceStrength": { "type": "number", "minimum": 0, "maximum": 0.75 },
            "surfaceColor": { "$ref": "#/$defs/color" },
            "secondaryColor": { "$ref": "#/$defs/color" },
            "deepColor": { "$ref": "#/$defs/color" },
            "depthColorRange": { "type": "number", "exclusiveMinimum": 0, "maximum": 32 },
            "gridLineColor": { "$ref": "#/$defs/color" },
            "gridLineOpacity": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "world": {
          "type": "object",
          "description": "出现这个块表示场景的地面与物件由世界种子确定性生成并按 chunk 流式加载",
          "additionalProperties": false,
          "required": ["loadRadius", "keepRadius", "rockColor"],
          "properties": {
            "loadRadius": { "type": "integer", "minimum": 1, "maximum": 6 },
            "keepRadius": { "type": "integer", "minimum": 2, "maximum": 8 },
            "rockColor": { "$ref": "#/$defs/color" },
            "grassPatches": {
              "type": "object",
              "description": "在稀疏草簇之上，按 chunk 确定性生成的成片密草",
              "additionalProperties": false,
              "required": ["maxPerChunk", "spawnChance", "minRadius", "maxRadius", "bladeDensity"],
              "properties": {
                "maxPerChunk": { "type": "integer", "minimum": 0, "maximum": 8 },
                "spawnChance": { "type": "number", "minimum": 0, "maximum": 1 },
                "minRadius": { "type": "number", "exclusiveMinimum": 0, "maximum": 12 },
                "maxRadius": { "type": "number", "exclusiveMinimum": 0, "maximum": 12 },
                "bladeDensity": { "type": "number", "exclusiveMinimum": 0, "maximum": 80 }
              }
            }
          }
        }
      }
    },
    "gameplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerActor", "spawn"],
      "properties": {
        "playerActor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["archetype"],
          "properties": {
            "archetype": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          }
        },
        "runtimeActorArchetypes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "startingInventory": {
          "type": "array",
          "description": "新玩家进房间时发到背包里的物品；给没有可采集材料的地图用（例如纯海域图上扩建船体的木头）",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["itemType", "quantity"],
            "properties": {
              "itemType": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "quantity": { "type": "integer", "minimum": 1, "maximum": 999 }
            }
          }
        },
        "worldProps": {
          "type": "object",
          "description": "流式世界里每种物件的带权原型变体；同一放置记录由世界种子哈希确定选择结果",
          "additionalProperties": false,
          "properties": {
            "tree": { "$ref": "#/$defs/worldPropVariants" },
            "grass": { "$ref": "#/$defs/worldPropVariants" },
            "rock": { "$ref": "#/$defs/worldPropVariants" },
            "mushroom": { "$ref": "#/$defs/worldPropVariants" }
          }
        },
        "creatureSpawns": {
          "type": "array",
          "description": "生物自然刷新。规则照 Minecraft 的自然刷新：按周期在玩家周围的圆环里试着落一小群，有配额、有刷新区块、走远了会消失。只能用在带 renderer.world 的流式场景上。",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["archetype", "capPerPlayer"],
            "properties": {
              "archetype": {
                "description": "刷出来的是哪种 Actor。原型会自动进入场景原型表，不必在 runtimeActorArchetypes 里重复写。",
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "capPerPlayer": { "description": "每名在场玩家给这种生物的配额。房间里没有人时配额是 0。", "type": "integer", "minimum": 1, "maximum": 32 },
              "maximumPerRoom": { "description": "全房间的硬上限，压过按人头算出来的配额。", "type": "integer", "minimum": 1, "maximum": 256 },
              "cycleSeconds": { "description": "隔多少秒跑一次刷新周期。不是每 tick 都刷。", "type": "number", "exclusiveMinimum": 0, "maximum": 600 },
              "attemptsPerCycle": { "description": "一个周期最多试几个候选点。地形不合适就放弃，不重试到成功。", "type": "integer", "minimum": 1, "maximum": 32 },
              "packMaximum": { "description": "一次成群刷出来的上限。1 就是一次一只。", "type": "integer", "minimum": 1, "maximum": 8 },
              "minimumDistance": { "description": "离玩家这么近以内不刷，米。", "type": "number", "minimum": 2, "maximum": 256 },
              "maximumDistance": { "description": "刷新圆环的外径，米。它同时决定消失距离：出了这个范围随机消失，出了一倍半立刻消失。必须大于 minimumDistance。", "type": "number", "minimum": 4, "maximum": 512 },
              "chunkOneIn": { "description": "几分之一的 chunk 会出这种生物。像 Minecraft 的史莱姆区块一样由世界种子决定，写 1 表示到处都出。", "type": "integer", "minimum": 1, "maximum": 64 },
              "nightOnly": { "description": "只在夜里刷。需要场景开启 environment.dayNight。", "type": "boolean" }
            }
          }
        },
        "bounds": {
          "type": "object",
          "description": "玩法平面的活动范围。renderer.world 的流式场景可以省略，玩家便可一直走下去（范围取世界的精度护栏）；固定尺寸场景必须写。",
          "additionalProperties": false,
          "required": ["minimumX", "maximumX", "minimumZ", "maximumZ"],
          "properties": {
            "minimumX": { "type": "number" },
            "maximumX": { "type": "number" },
            "minimumZ": { "type": "number" },
            "maximumZ": { "type": "number" }
          }
        },
        "spawn": {
          "type": "object",
          "additionalProperties": false,
          "required": ["centerX", "centerZ", "radius", "slots"],
          "properties": {
            "centerX": { "type": "number" },
            "centerZ": { "type": "number" },
            "radius": { "type": "number", "minimum": 0 },
            "slots": { "type": "integer", "minimum": 1, "maximum": 64 }
          }
        },
        "water": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seaLevel"],
          "properties": {
            "seaLevel": { "type": "number" }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "position", "yaw", "pitch", "moveSpeed"],
      "properties": {
        "mode": { "enum": ["topdown", "fly"] },
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "yaw": { "type": "number" },
        "pitch": { "type": "number", "minimum": -1.5, "maximum": 1.5 },
        "moveSpeed": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sceneComponents": {
            "contains": {
              "type": "object",
              "properties": { "type": { "const": "mouse-grass-interaction" } },
              "required": ["type"]
            }
          }
        },
        "required": ["sceneComponents"]
      },
      "then": {
        "properties": {
          "renderer": {
            "properties": {
              "content": {
                "properties": { "grass": { "const": true } },
                "required": ["grass"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sceneComponents": {
            "contains": {
              "type": "object",
              "properties": { "type": { "const": "ability-lab" } },
              "required": ["type"]
            }
          }
        },
        "required": ["sceneComponents"]
      },
      "then": {
        "properties": {
          "camera": {
            "properties": { "mode": { "const": "topdown" } },
            "required": ["mode"]
          }
        }
      }
    }
  ],
  "$defs": {
    "weatherType": {
      "enum": ["sunny", "cloudy", "fog", "rain", "storm", "snow", "blizzard"]
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "worldPropVariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["archetype", "weight"],
        "properties": {
          "archetype": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "weight": { "type": "integer", "minimum": 1, "maximum": 1000 }
        }
      }
    }
  }
}
