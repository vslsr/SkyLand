{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyland.local/schema/scene.schema.json",
  "title": "SkyLand Scene Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "description",
    "capacity",
    "renderer",
    "gameplay",
    "camera"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "capacity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "background",
        "fog",
        "content",
        "palette"
      ],
      "properties": {
        "type": {
          "const": "line-art"
        },
        "background": {
          "$ref": "#/$defs/color"
        },
        "fog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color",
            "near",
            "far"
          ],
          "properties": {
            "color": {
              "$ref": "#/$defs/color"
            },
            "near": {
              "type": "number",
              "minimum": 0
            },
            "far": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ground",
            "trees",
            "grass",
            "ocean"
          ],
          "properties": {
            "ground": {
              "type": "boolean"
            },
            "trees": {
              "type": "boolean"
            },
            "grass": {
              "type": "boolean"
            },
            "ocean": {
              "type": "boolean"
            }
          }
        },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ground",
            "grass",
            "treeTrunk",
            "treeNeedles"
          ],
          "properties": {
            "ground": {
              "$ref": "#/$defs/color"
            },
            "grass": {
              "$ref": "#/$defs/color"
            },
            "treeTrunk": {
              "$ref": "#/$defs/color"
            },
            "treeNeedles": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "ocean": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "segments",
            "waveHeight",
            "waveSpeed",
            "noiseScale",
            "noiseStrength",
            "interlaceStrength",
            "surfaceColor",
            "secondaryColor",
            "gridLineColor",
            "gridLineOpacity",
            "foamColor",
            "demoRaft"
          ],
          "properties": {
            "size": {
              "type": "number",
              "minimum": 16,
              "maximum": 1024
            },
            "segments": {
              "type": "integer",
              "minimum": 8,
              "maximum": 128
            },
            "waveHeight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "waveSpeed": {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            },
            "noiseScale": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "noiseStrength": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "interlaceStrength": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.75
            },
            "surfaceColor": {
              "$ref": "#/$defs/color"
            },
            "secondaryColor": {
              "$ref": "#/$defs/color"
            },
            "gridLineColor": {
              "$ref": "#/$defs/color"
            },
            "gridLineOpacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "foamColor": {
              "$ref": "#/$defs/color"
            },
            "demoRaft": {
              "type": "boolean"
            }
          }
        },
        "world": {
          "type": "object",
          "description": "出现这个块表示场景的地面与物件由世界种子确定性生成并按 chunk 流式加载",
          "additionalProperties": false,
          "required": [
            "loadRadius",
            "keepRadius",
            "rockColor"
          ],
          "properties": {
            "loadRadius": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6,
              "description": "以焦点所在 chunk 为中心向外加载几圈"
            },
            "keepRadius": {
              "type": "integer",
              "minimum": 2,
              "maximum": 8,
              "description": "走出几圈之外才卸载，必须大于 loadRadius"
            },
            "rockColor": {
              "$ref": "#/$defs/color",
              "description": "岩石的填充色"
            }
          }
        }
      }
    },
    "gameplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounds",
        "spawn"
      ],
      "properties": {
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimumX",
            "maximumX",
            "minimumZ",
            "maximumZ"
          ],
          "properties": {
            "minimumX": {
              "type": "number"
            },
            "maximumX": {
              "type": "number"
            },
            "minimumZ": {
              "type": "number"
            },
            "maximumZ": {
              "type": "number"
            }
          }
        },
        "spawn": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "centerX",
            "centerZ",
            "radius",
            "slots"
          ],
          "properties": {
            "centerX": {
              "type": "number"
            },
            "centerZ": {
              "type": "number"
            },
            "radius": {
              "type": "number",
              "minimum": 0
            },
            "slots": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          }
        },
        "water": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seaLevel"
          ],
          "properties": {
            "seaLevel": {
              "type": "number"
            }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "position",
        "yaw",
        "pitch",
        "moveSpeed"
      ],
      "properties": {
        "mode": {
          "enum": [
            "topdown",
            "fly"
          ]
        },
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "yaw": {
          "type": "number"
        },
        "pitch": {
          "type": "number",
          "minimum": -1.5,
          "maximum": 1.5
        },
        "moveSpeed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
