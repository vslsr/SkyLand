{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyland.local/schemas/input-profile.schema.json",
  "title": "SkyLand Input Scheme",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "inputActions", "inputConfig", "inputMappingContexts", "devicePrompts", "virtualControls"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "inputActions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "inputConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindings"],
      "properties": {
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tag", "actionId"],
            "properties": {
              "tag": { "type": "string", "pattern": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)+$" },
              "actionId": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "inputMappingContexts": {
      "type": "array",
      "items": { "$ref": "#/$defs/context" }
    },
    "devicePrompts": { "$ref": "#/$defs/devicePrompts" },
    "virtualControls": { "$ref": "#/$defs/virtualControls" }
  },
  "$defs": {
    "deviceKind": { "enum": ["keyboardMouse", "touch", "gamepad"] },
    "axis2D": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "pressed" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "thresholdMs"],
          "properties": { "type": { "const": "hold" }, "thresholdMs": { "type": "number", "minimum": 0 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "maximumGapMs"],
          "properties": {
            "type": { "const": "doubleTap" },
            "maximumGapMs": { "type": "number", "exclusiveMinimum": 0 },
            "maximumTapMs": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },
    "modifier": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "minimum"],
          "properties": {
            "type": { "const": "deadZone" },
            "minimum": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
            "maximum": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "x", "y"],
          "properties": { "type": { "const": "scale" }, "x": { "type": "number" }, "y": { "type": "number" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "negate" }, "axes": { "enum": ["x", "y", "xy"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "normalize" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "order"],
          "properties": { "type": { "const": "swizzle" }, "order": { "enum": ["xy", "yx"] } }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "valueType"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "valueType": { "enum": ["digital", "axis2D"] },
        "trigger": { "$ref": "#/$defs/trigger" },
        "modifiers": { "type": "array", "items": { "$ref": "#/$defs/modifier" } },
        "deadZone": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "deviceKind", "control", "actionId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "deviceKind": { "$ref": "#/$defs/deviceKind" },
        "control": { "type": "string", "minLength": 1 },
        "actionId": { "type": "string", "minLength": 1 },
        "axis2D": { "$ref": "#/$defs/axis2D" },
        "scale": { "$ref": "#/$defs/axis2D" },
        "modifiers": { "type": "array", "items": { "$ref": "#/$defs/modifier" } },
        "consume": { "type": "boolean" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "mappings"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "priority": { "type": "number" },
        "activeByDefault": { "type": "boolean" },
        "mappings": { "type": "array", "items": { "$ref": "#/$defs/mapping" } }
      }
    },
    "promptEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "mappingIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "text": { "type": "string", "minLength": 1 },
        "joinWith": { "type": "string", "minLength": 1 }
      },
      "anyOf": [{ "required": ["mappingIds"] }, { "required": ["text"] }]
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "deviceKind"],
      "properties": {
        "mode": { "type": "string", "minLength": 1 },
        "deviceKind": { "$ref": "#/$defs/deviceKind" },
        "state": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/promptEntry" } },
        "separator": { "type": "string", "minLength": 1 }
      },
      "anyOf": [{ "required": ["text"] }, { "required": ["entries"] }]
    },
    "devicePrompts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlLabels", "prompts"],
      "properties": {
        "controlLabels": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "prompts": { "type": "array", "items": { "$ref": "#/$defs/prompt" } }
      }
    },
    "virtualLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeInsetPx", "bottomInsetPx", "buttonGapPx", "scale"],
      "properties": {
        "edgeInsetPx": { "type": "number", "minimum": 0, "maximum": 128 },
        "bottomInsetPx": { "type": "number", "minimum": 0, "maximum": 192 },
        "buttonGapPx": { "type": "number", "minimum": 0, "maximum": 48 },
        "scale": { "type": "number", "minimum": 0.5, "maximum": 1.5 }
      }
    },
    "virtualJoystick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "mode", "baseRadiusPx", "travelRadiusPx", "knobRadiusPx", "deadZone", "sensitivity", "activationWidthRatio", "activationHeightRatio"],
      "properties": {
        "control": { "type": "string", "pattern": "^Virtual\\..+" },
        "mode": { "enum": ["fixed", "floating"] },
        "baseRadiusPx": { "type": "number", "minimum": 32, "maximum": 128 },
        "travelRadiusPx": { "type": "number", "minimum": 8, "maximum": 128 },
        "knobRadiusPx": { "type": "number", "minimum": 8, "maximum": 128 },
        "deadZone": { "type": "number", "minimum": 0, "maximum": 0.95 },
        "sensitivity": { "type": "number", "minimum": 0.1, "maximum": 3 },
        "activationWidthRatio": { "type": "number", "minimum": 0.2, "maximum": 0.8 },
        "activationHeightRatio": { "type": "number", "minimum": 0.25, "maximum": 0.9 }
      }
    },
    "virtualAimJoystick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "chargeControl", "baseRadiusPx", "travelRadiusPx", "innerRadiusPx", "knobRadiusPx", "deadZone", "sensitivity", "activationWidthRatio", "activationHeightRatio"],
      "properties": {
        "control": { "type": "string", "pattern": "^Virtual\\..+" },
        "chargeControl": { "type": "string", "pattern": "^Virtual\\..+" },
        "baseRadiusPx": { "type": "number", "minimum": 32, "maximum": 128 },
        "travelRadiusPx": { "type": "number", "minimum": 8, "maximum": 128 },
        "innerRadiusPx": { "type": "number", "minimum": 8, "maximum": 128 },
        "knobRadiusPx": { "type": "number", "minimum": 8, "maximum": 128 },
        "deadZone": { "type": "number", "minimum": 0, "maximum": 0.95 },
        "sensitivity": { "type": "number", "minimum": 0.1, "maximum": 3 },
        "activationWidthRatio": { "type": "number", "minimum": 0.2, "maximum": 0.8 },
        "activationHeightRatio": { "type": "number", "minimum": 0.25, "maximum": 0.9 }
      }
    },
    "virtualButton": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "control", "label", "ariaLabel", "sizePx", "gridColumn", "gridRow"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "control": { "type": "string", "pattern": "^Virtual\\..+" },
        "label": { "type": "string", "minLength": 1 },
        "ariaLabel": { "type": "string", "minLength": 1 },
        "sizePx": { "type": "number", "minimum": 36, "maximum": 128 },
        "gridColumn": { "type": "integer", "minimum": 1, "maximum": 4 },
        "gridRow": { "type": "integer", "minimum": 1, "maximum": 6 },
        "rowSpan": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    },
    "virtualControls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desktopDebugQueryParameter", "joystick", "buttons", "layouts"],
      "properties": {
        "desktopDebugQueryParameter": { "type": "string", "minLength": 1 },
        "joystick": { "$ref": "#/$defs/virtualJoystick" },
        "aimJoystick": { "$ref": "#/$defs/virtualAimJoystick" },
        "buttons": { "type": "array", "items": { "$ref": "#/$defs/virtualButton" } },
        "layouts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["landscape", "portrait"],
          "properties": {
            "landscape": { "$ref": "#/$defs/virtualLayout" },
            "portrait": { "$ref": "#/$defs/virtualLayout" }
          }
        }
      }
    }
  }
}
