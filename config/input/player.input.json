{
  "$schema": "./input-profile.schema.json",
  "schemaVersion": 1,
  "id": "InputScheme.Player.Default",
  "inputActions": [
    {
      "id": "IA_Player_Move",
      "valueType": "axis2D",
      "modifiers": [{ "type": "deadZone", "minimum": 0.12 }],
      "trigger": { "type": "pressed" }
    },
    {
      "id": "IA_Vessel_Move",
      "valueType": "axis2D",
      "modifiers": [{ "type": "deadZone", "minimum": 0.12 }],
      "trigger": { "type": "pressed" }
    },
    {
      "id": "IA_Player_Sprint",
      "valueType": "digital",
      "trigger": { "type": "pressed" }
    },
    {
      "id": "IA_Player_Primary",
      "valueType": "digital",
      "trigger": { "type": "pressed" }
    },
    {
      "id": "IA_Player_Interact",
      "valueType": "digital",
      "trigger": { "type": "pressed" }
    },
    {
      "id": "IA_World_Interact",
      "valueType": "digital",
      "trigger": { "type": "pressed" }
    },
    {
      "id": "IA_AbilityLab_Arcane",
      "valueType": "digital",
      "trigger": { "type": "pressed" }
    },
    {
      "id": "IA_AbilityLab_Burn",
      "valueType": "digital",
      "trigger": { "type": "pressed" }
    },
    {
      "id": "IA_AbilityLab_Rage",
      "valueType": "digital",
      "trigger": { "type": "pressed" }
    },
    {
      "id": "IA_AbilityLab_Silence",
      "valueType": "digital",
      "trigger": { "type": "pressed" }
    },
    {
      "id": "IA_AbilityLab_Reset",
      "valueType": "digital",
      "trigger": { "type": "pressed" }
    },
    {
      "id": "IA_Debug_Menu",
      "valueType": "digital",
      "trigger": { "type": "pressed" }
    },
    {
      "id": "IA_Player_Dodge",
      "valueType": "digital",
      "trigger": { "type": "doubleTap", "maximumGapMs": 260, "maximumTapMs": 220 }
    }
  ],
  "inputConfig": {
    "bindings": [
      { "tag": "Input.Player.Move", "actionId": "IA_Player_Move" },
      { "tag": "Input.Vessel.Move", "actionId": "IA_Vessel_Move" },
      { "tag": "Input.Player.Sprint", "actionId": "IA_Player_Sprint" },
      { "tag": "Input.Player.Primary", "actionId": "IA_Player_Primary" },
      { "tag": "Input.Player.Interact", "actionId": "IA_Player_Interact" },
      { "tag": "Input.World.Interact", "actionId": "IA_World_Interact" },
      { "tag": "Input.AbilityLab.Arcane", "actionId": "IA_AbilityLab_Arcane" },
      { "tag": "Input.AbilityLab.Burn", "actionId": "IA_AbilityLab_Burn" },
      { "tag": "Input.AbilityLab.Rage", "actionId": "IA_AbilityLab_Rage" },
      { "tag": "Input.AbilityLab.Silence", "actionId": "IA_AbilityLab_Silence" },
      { "tag": "Input.AbilityLab.Reset", "actionId": "IA_AbilityLab_Reset" },
      { "tag": "Input.Debug.Menu", "actionId": "IA_Debug_Menu" },
      { "tag": "Input.Player.Dodge", "actionId": "IA_Player_Dodge" }
    ]
  },
  "inputMappingContexts": [
    {
      "id": "IMC.Gameplay",
      "priority": 100,
      "activeByDefault": true,
      "mappings": [
        { "id": "Move.Keyboard.Up", "deviceKind": "keyboardMouse", "control": "Keyboard.KeyW", "actionId": "IA_Player_Move", "axis2D": { "x": 0, "y": 1 } },
        { "id": "Move.Keyboard.Down", "deviceKind": "keyboardMouse", "control": "Keyboard.KeyS", "actionId": "IA_Player_Move", "axis2D": { "x": 0, "y": -1 } },
        { "id": "Move.Keyboard.Left", "deviceKind": "keyboardMouse", "control": "Keyboard.KeyA", "actionId": "IA_Player_Move", "axis2D": { "x": -1, "y": 0 } },
        { "id": "Move.Keyboard.Right", "deviceKind": "keyboardMouse", "control": "Keyboard.KeyD", "actionId": "IA_Player_Move", "axis2D": { "x": 1, "y": 0 } },
        { "id": "Move.Touch.Stick", "deviceKind": "touch", "control": "Virtual.MoveStick", "actionId": "IA_Player_Move" },
        { "id": "Move.Gamepad.Stick", "deviceKind": "gamepad", "control": "Gamepad.LeftStick", "actionId": "IA_Player_Move", "modifiers": [{ "type": "negate", "axes": "y" }] },
        { "id": "Move.Gamepad.Up", "deviceKind": "gamepad", "control": "Gamepad.DPadUp", "actionId": "IA_Player_Move", "axis2D": { "x": 0, "y": 1 } },
        { "id": "Move.Gamepad.Down", "deviceKind": "gamepad", "control": "Gamepad.DPadDown", "actionId": "IA_Player_Move", "axis2D": { "x": 0, "y": -1 } },
        { "id": "Move.Gamepad.Left", "deviceKind": "gamepad", "control": "Gamepad.DPadLeft", "actionId": "IA_Player_Move", "axis2D": { "x": -1, "y": 0 } },
        { "id": "Move.Gamepad.Right", "deviceKind": "gamepad", "control": "Gamepad.DPadRight", "actionId": "IA_Player_Move", "axis2D": { "x": 1, "y": 0 } },

        { "id": "Vessel.Keyboard.Forward", "deviceKind": "keyboardMouse", "control": "Keyboard.ArrowUp", "actionId": "IA_Vessel_Move", "axis2D": { "x": 0, "y": 1 } },
        { "id": "Vessel.Keyboard.Reverse", "deviceKind": "keyboardMouse", "control": "Keyboard.ArrowDown", "actionId": "IA_Vessel_Move", "axis2D": { "x": 0, "y": -1 } },
        { "id": "Vessel.Keyboard.Left", "deviceKind": "keyboardMouse", "control": "Keyboard.ArrowLeft", "actionId": "IA_Vessel_Move", "axis2D": { "x": -1, "y": 0 } },
        { "id": "Vessel.Keyboard.Right", "deviceKind": "keyboardMouse", "control": "Keyboard.ArrowRight", "actionId": "IA_Vessel_Move", "axis2D": { "x": 1, "y": 0 } },

        { "id": "Sprint.Keyboard.Primary", "deviceKind": "keyboardMouse", "control": "Keyboard.ShiftLeft", "actionId": "IA_Player_Sprint" },
        { "id": "Sprint.Keyboard.Alternate", "deviceKind": "keyboardMouse", "control": "Keyboard.ShiftRight", "actionId": "IA_Player_Sprint" },
        { "id": "Sprint.Touch.Button", "deviceKind": "touch", "control": "Virtual.SprintButton", "actionId": "IA_Player_Sprint" },
        { "id": "Sprint.Gamepad.Button", "deviceKind": "gamepad", "control": "Gamepad.LeftStickButton", "actionId": "IA_Player_Sprint" },

        { "id": "Primary.Mouse.Button", "deviceKind": "keyboardMouse", "control": "Mouse.Button0", "actionId": "IA_Player_Primary" },
        { "id": "Primary.Gamepad.Button", "deviceKind": "gamepad", "control": "Gamepad.ButtonSouth", "actionId": "IA_Player_Primary" },
        { "id": "Primary.Gamepad.Trigger", "deviceKind": "gamepad", "control": "Gamepad.RightTrigger", "actionId": "IA_Player_Primary" },
        { "id": "Interact.Keyboard.Primary", "deviceKind": "keyboardMouse", "control": "Keyboard.KeyF", "actionId": "IA_Player_Interact" },
        { "id": "Interact.Touch.Button", "deviceKind": "touch", "control": "Virtual.InteractButton", "actionId": "IA_Player_Interact" },
        { "id": "Interact.Gamepad.Button", "deviceKind": "gamepad", "control": "Gamepad.ButtonWest", "actionId": "IA_Player_Interact" },
        { "id": "WorldInteract.Keyboard.Primary", "deviceKind": "keyboardMouse", "control": "Keyboard.KeyE", "actionId": "IA_World_Interact" },
        { "id": "WorldInteract.Gamepad.Button", "deviceKind": "gamepad", "control": "Gamepad.ButtonNorth", "actionId": "IA_World_Interact" },
        { "id": "AbilityLab.Keyboard.Arcane", "deviceKind": "keyboardMouse", "control": "Keyboard.Digit1", "actionId": "IA_AbilityLab_Arcane" },
        { "id": "AbilityLab.Keyboard.Burn", "deviceKind": "keyboardMouse", "control": "Keyboard.Digit2", "actionId": "IA_AbilityLab_Burn" },
        { "id": "AbilityLab.Keyboard.Rage", "deviceKind": "keyboardMouse", "control": "Keyboard.Digit3", "actionId": "IA_AbilityLab_Rage" },
        { "id": "AbilityLab.Keyboard.Silence", "deviceKind": "keyboardMouse", "control": "Keyboard.Digit4", "actionId": "IA_AbilityLab_Silence" },
        { "id": "AbilityLab.Keyboard.Reset", "deviceKind": "keyboardMouse", "control": "Keyboard.Digit0", "actionId": "IA_AbilityLab_Reset" },
        { "id": "Dodge.Keyboard.Primary", "deviceKind": "keyboardMouse", "control": "Keyboard.Space", "actionId": "IA_Player_Dodge" },
        { "id": "Dodge.Touch.Button", "deviceKind": "touch", "control": "Virtual.DodgeButton", "actionId": "IA_Player_Dodge" },
        { "id": "Dodge.Gamepad.Button", "deviceKind": "gamepad", "control": "Gamepad.ButtonEast", "actionId": "IA_Player_Dodge" }
      ]
    },
    {
      "id": "IMC.Development",
      "priority": 1000,
      "activeByDefault": true,
      "mappings": [
        { "id": "DebugMenu.Keyboard.F8", "deviceKind": "keyboardMouse", "control": "Keyboard.F8", "actionId": "IA_Debug_Menu" }
      ]
    }
  ],
  "devicePrompts": {
    "controlLabels": {
      "Keyboard.KeyW": "W",
      "Keyboard.KeyA": "A",
      "Keyboard.KeyS": "S",
      "Keyboard.KeyD": "D",
      "Keyboard.ArrowUp": "↑",
      "Keyboard.ArrowDown": "↓",
      "Keyboard.ArrowLeft": "←",
      "Keyboard.ArrowRight": "→",
      "Keyboard.KeyF": "F",
      "Keyboard.KeyE": "E",
      "Keyboard.Digit0": "0",
      "Keyboard.Digit1": "1",
      "Keyboard.Digit2": "2",
      "Keyboard.Digit3": "3",
      "Keyboard.Digit4": "4",
      "Keyboard.F8": "F8",
      "Keyboard.ShiftLeft": "Shift",
      "Mouse.Button0": "鼠标左键",
      "Virtual.MoveStick": "触摸摇杆",
      "Virtual.SprintButton": "RUN",
      "Gamepad.LeftStick": "左摇杆",
      "Gamepad.LeftStickButton": "L3"
    },
    "prompts": [
      {
        "mode": "fly",
        "deviceKind": "keyboardMouse",
        "state": "unlocked",
        "text": "点击画面 · WASD 自由镜头 · F 接管木筏"
      },
      {
        "mode": "fly",
        "deviceKind": "keyboardMouse",
        "state": "locked",
        "text": "WASD · 镜头　方向键 · 驾船　F · 接管/释放　E · 装卸　Esc · 释放鼠标"
      },
      {
        "mode": "topdown",
        "deviceKind": "keyboardMouse",
        "entries": [
          { "label": "移动", "mappingIds": ["Move.Keyboard.Up", "Move.Keyboard.Left", "Move.Keyboard.Down", "Move.Keyboard.Right"], "joinWith": "/" },
          { "label": "朝向", "text": "鼠标" },
          { "label": "加速", "mappingIds": ["Sprint.Keyboard.Primary"] }
        ]
      },
      {
        "mode": "topdown",
        "deviceKind": "touch",
        "entries": [
          { "label": "移动", "mappingIds": ["Move.Touch.Stick"] },
          { "label": "加速", "mappingIds": ["Sprint.Touch.Button"] }
        ]
      },
      {
        "mode": "topdown",
        "deviceKind": "gamepad",
        "entries": [
          { "label": "移动", "mappingIds": ["Move.Gamepad.Stick"] },
          { "label": "加速", "mappingIds": ["Sprint.Gamepad.Button"] }
        ]
      }
    ]
  },
  "virtualControls": {
    "desktopDebugQueryParameter": "virtual-controls",
    "joystick": {
      "control": "Virtual.MoveStick",
      "mode": "floating",
      "baseRadiusPx": 62,
      "travelRadiusPx": 44,
      "knobRadiusPx": 22,
      "deadZone": 0.08,
      "sensitivity": 1.08,
      "activationWidthRatio": 0.48,
      "activationHeightRatio": 0.62
    },
    "buttons": [
      {
        "id": "sprint",
        "control": "Virtual.SprintButton",
        "label": "RUN",
        "ariaLabel": "加速",
        "sizePx": 64,
        "gridColumn": 1,
        "gridRow": 1,
        "rowSpan": 2
      },
      {
        "id": "interact",
        "control": "Virtual.InteractButton",
        "label": "USE",
        "ariaLabel": "交互",
        "sizePx": 58,
        "gridColumn": 2,
        "gridRow": 1
      },
      {
        "id": "dodge",
        "control": "Virtual.DodgeButton",
        "label": "2×",
        "ariaLabel": "双击闪避",
        "sizePx": 58,
        "gridColumn": 2,
        "gridRow": 2
      }
    ],
    "layouts": {
      "landscape": {
        "edgeInsetPx": 24,
        "bottomInsetPx": 24,
        "buttonGapPx": 10,
        "scale": 1
      },
      "portrait": {
        "edgeInsetPx": 16,
        "bottomInsetPx": 20,
        "buttonGapPx": 8,
        "scale": 0.9
      }
    }
  }
}
